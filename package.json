{
  "name": "mpfrontend-workspace",
  "version": "0.1.0-dev.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "check": "node tools/verify-public-repository.mjs && nx run-many -t lint typecheck test build",
    "public:verify": "node tools/verify-public-repository.mjs",
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "pack:local": "nx run distribution:pack-check"
  },
  "devDependencies": {
    "nx": "23.2.1",
    "typescript": "5.9.3",
    "tsx": "4.23.15",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "@types/ws": "8.18.2",
    "@nx/eslint-plugin": "23.2.1",
    "eslint": "10.12.0",
    "typescript-eslint": "8.71.1",
    "tailwindcss": "4.3.3"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "next": "16.3.8",
    "@apidevtools/swagger-parser": "13.1.0",
    "yaml": "2.9.1",
    "ws": "8.22.0"
  }
}
