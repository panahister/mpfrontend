{
  "name": "ftg-cli",
  "root": "packages/ftg-cli",
  "sourceRoot": "packages/ftg-cli/src",
  "projectType": "library",
  "tags": [
    "scope:platform",
    "runtime:tooling",
    "type:tool"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p packages/ftg-cli/tsconfig.json"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p packages/ftg-cli/tsconfig.json --noEmit"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint packages/ftg-cli/src packages/ftg-cli/tests"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --import tsx --test packages/ftg-cli/tests/*.test.ts",
        "env": { "TSX_TSCONFIG_PATH": "tsconfig.base.json" }
      }
    }
  }
}
