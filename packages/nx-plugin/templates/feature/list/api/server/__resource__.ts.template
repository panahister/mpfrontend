import 'server-only';
import { listSearchParams, type ListState } from '@mpfrontend/ftg-core';
import { bffOrigin, appId } from '../../config/server';
import { localeRegistry } from '../../config/app';
import { __RESOURCE_CONSTANT___LIST, type __Resource__Page } from '../../entities/__resource__';
import { parseRead } from '__SERVER_TO_OUTPUT__/read-models.gen';

/**
 * The trusted server boundary of the resource: a list state in, only the parameters that the list protocol declares
 * sent to the BFF, a validated response out.
 */
export async function read__Resource__(
  state: ListState,
  language: string = localeRegistry.defaultLocale,
): Promise<__Resource__Page> {
  const path = '/' + appId + '/__resource__?' + listSearchParams(__RESOURCE_CONSTANT___LIST, state);
  const response = await fetch(bffOrigin + path, {
    cache: 'no-store',
    headers: { 'Accept-Language': language },
    signal: AbortSignal.timeout(10000),
  });
  if (!response.ok) throw new Error('__RESOURCE_CONSTANT___UNAVAILABLE');
  return parseRead('__resource__', await response.json());
}
