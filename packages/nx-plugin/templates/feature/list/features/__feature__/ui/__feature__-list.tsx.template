'use client';
import { PageFrame } from '@mpfrontend/app-layout';
import { Card, ResourceTable, type DisplayField } from '@mpfrontend/ui';
import { formatValue } from '@mpfrontend/i18n';
import { localeRegistry } from '../../../config/app';
import { itemPosition, type __Resource__Page } from '../../../entities/__resource__';
import { use__Feature__List } from '../hooks/use-__feature__-list';
import { messages } from '../model/messages';
import { labels } from '../model/overrides';
import { detailHref } from '../utils/__feature__-href';

type Props = Readonly<{
  initialPage: __Resource__Page | null;
  initialSearch: string;
  fields: readonly DisplayField[];
  language: string;
  basePath: string;
}>;

/** The list view: it renders the page that the URL state selects and emits paging and filter intent. */
export function __Feature__List({ initialPage, initialSearch, fields, language, basePath }: Props) {
  const t = messages.translator(language);
  const { table, page, unavailable } = use__Feature__List({ search: initialSearch, page: initialPage });
  return (
    <PageFrame title={t('title')}>
      {unavailable ? (
        <p
          role="alert"
          className="border-s-4 border-[color:var(--mp-status-warning)] bg-[color:var(--mp-status-warningsurface)] p-4"
        >
          {t('unavailable')}
        </p>
      ) : page === undefined ? (
        <p role="status">{t('loading')}</p>
      ) : (
        <Card>
          <ResourceTable
            fields={fields}
            rows={page.items}
            caption={t('title')}
            format={(value) =>
              formatValue(value, language, localeRegistry, { true: t('yes'), false: t('no') })
            }
            labels={{ ...labels, detail: t('detail'), search: t('search') }}
            detail={(row) => (
              <a
                href={detailHref(
                  basePath,
                  itemPosition(page.number, table.size, page.items.indexOf(row as never)),
                )}
              >
                {t('detail')}
              </a>
            )}
            control={{
              mode: 'server',
              ...table,
              total: page.total,
              filterable: ['search'],
              text: {
                pagination: t('pagination'),
                previous: t('previous'),
                next: t('next'),
                page: (number, count) => t('pageOf', { page: number, count: count ?? number }),
                apply: t('apply'),
                filters: t('search'),
              },
            }}
          />
          {page.items.length === 0 && <p>{t('empty')}</p>}
        </Card>
      )}
    </PageFrame>
  );
}
