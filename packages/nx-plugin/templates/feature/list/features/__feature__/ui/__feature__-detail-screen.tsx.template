import { notFound } from 'next/navigation';
import { cookies } from 'next/headers';
import { preferenceCookie, visitorLocale } from '../../../config/app';
import { load__Feature__Item } from '../api/__feature__';
import { fields } from '../model/__feature__-fields';
import type { __Feature__ScreenProps } from './__feature__-screen';
import { __Feature__Detail } from './__feature__-detail';

/** The detail screen: a child route of the list, so an item can be linked and refreshed. */
export async function __Feature__DetailScreen({ params, basePath }: __Feature__ScreenProps) {
  const position = Number((await params)?.position);
  const language = visitorLocale((await cookies()).get(preferenceCookie.name)?.value);
  const item = await load__Feature__Item(position, language).catch(() => null);
  if (item === undefined) notFound();
  return <__Feature__Detail item={item} fields={fields} language={language} basePath={basePath} />;
}
