import 'server-only';
import type { ListState } from '@mpfrontend/ftg-core';
import { read__Resource__ } from '../../../api/server/__resource__';
import {
  locateItem,
  __RESOURCE_CONSTANT___PAGE_SIZE,
  type __Resource__Item,
  type __Resource__Page,
} from '../../../entities/__resource__';

/** The first page of the list on the server, for the URL state of the request. */
export function load__Feature__Page(state: ListState, language: string): Promise<__Resource__Page> {
  return read__Resource__(state, language);
}

/** The item at a list position, or undefined when the position is outside the list. */
export async function load__Feature__Item(
  position: number,
  language: string,
): Promise<__Resource__Item | undefined> {
  const location = locateItem(position, __RESOURCE_CONSTANT___PAGE_SIZE);
  if (!location) return undefined;
  const page = await read__Resource__(
    { page: location.page, size: __RESOURCE_CONSTANT___PAGE_SIZE },
    language,
  );
  return page.items[location.index];
}
