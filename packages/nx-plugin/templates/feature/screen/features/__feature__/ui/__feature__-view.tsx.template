import { PageFrame } from '@mpfrontend/app-layout';
import { Button, Card } from '@mpfrontend/ui';
import type { __Feature__Status } from '../model/__feature__';
import { messages } from '../model/messages';

type Props = Readonly<{
  status: __Feature__Status;
  available: boolean;
  language: string;
  onStart: () => void;
}>;

/** The view renders the state it is given and emits the start intent; it holds no workflow state. */
export function __Feature__View({ status, available, language, onStart }: Props) {
  const t = messages.translator(language);
  const message = !available
    ? t('unbound')
    : status === 'done'
      ? t('done')
      : status === 'failed'
        ? t('failed')
        : '';
  return (
    <PageFrame title={t('title')}>
      <Card>
        <Button
          onClick={onStart}
          restricted={!available}
          loading={status === 'running'}
          loadingLabel={t('running')}
        >
          {t('run')}
        </Button>
        <p role={status === 'failed' ? 'alert' : 'status'}>{message}</p>
      </Card>
    </PageFrame>
  );
}
