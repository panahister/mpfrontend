import { test } from 'node:test';
import assert from 'node:assert/strict';
import { createElement } from 'react';
import { renderToStaticMarkup } from 'react-dom/server';
import { __Feature__View } from './__feature__-view';

const render = (props: Parameters<typeof __Feature__View>[0]) =>
  renderToStaticMarkup(createElement(__Feature__View, props));

test('an unbound feature is announced and cannot start', () => {
  const html = render({ status: 'idle', available: false, onStart: () => {} });
  assert.match(html, /aria-disabled="true"/);
  assert.match(html, /role="status"/);
});

test('a running feature shows its busy state and a failure is an alert', () => {
  assert.match(
    render({ status: 'running', available: true, onStart: () => {} }),
    /aria-busy="true"/,
  );
  assert.match(render({ status: 'failed', available: true, onStart: () => {} }), /role="alert"/);
});
