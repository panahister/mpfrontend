{
  "name": "__name__",
  "projectType": "library",
  "sourceRoot": "__DIRECTORY__/src",
  "tags": ["type:package", "scope:shared", "runtime:__runtime__"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "pnpm exec tsc -p __DIRECTORY__/tsconfig.lib.json"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "command": "pnpm exec tsc -p __DIRECTORY__/tsconfig.json --noEmit"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "pnpm exec prettier --write __DIRECTORY__"
      }
    },
    "format:check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec prettier --check __DIRECTORY__"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec eslint __DIRECTORY__"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --import tsx --test \"__DIRECTORY__/src/**/*.test.ts\"",
        "env": {
          "TSX_TSCONFIG_PATH": "__DIRECTORY__/tsconfig.json"
        }
      }
    }
  }
}
