import { createLocaleRegistry, createPreferenceCookie } from '@mpfrontend/i18n';

/** The app id, safe on the client and the server. */
export const appId = '__APP_NAME__';

/**
 * The locales of this app; direction comes from here. The default is the first-visit locale. MP Frontend
 * ships English only: add each locale of the product here with its direction, for example
 * `'<code>': { direction: 'rtl' }`, and a `messages/<code>.ts` catalog to every catalog set (the catalog
 * check lists the missing ones). A product locale may also replace English as the default and only locale.
 */
export const localeRegistry = createLocaleRegistry({
  locales: { en: { direction: 'ltr' } },
  defaultLocale: 'en',
});

/**
 * The preference cookie shared with the identity provider's pages: language and theme only, allowlisted
 * values, never identity or authority. Set `preferenceCookieDomain` to the common parent domain to share it.
 */
export const preferenceCookie = createPreferenceCookie({
  name: 'mp_preferences',
  locales: localeRegistry.locales,
  themes: ['light', 'dark', 'system'],
});
export const preferenceCookieDomain: string | undefined = undefined;
/** The app's own brand choice; brands are not part of the shared preference cookie. */
export const brandCookie = appId + '_brand';

/** The visitor's language from the preference cookie's raw value, or the registry default. */
export function visitorLocale(cookieValue: string | undefined) {
  return localeRegistry.locale(preferenceCookie.parse(cookieValue).lang);
}
