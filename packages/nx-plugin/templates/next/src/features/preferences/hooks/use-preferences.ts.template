'use client';
import { useState } from 'react';
import { useRouter } from 'next/navigation';
import { direction } from '@mpfrontend/i18n';
import { persistPreference } from '../api/preference-cookie';
import { readPreferences, type PreferenceKey, type Preferences } from '../model/preferences';

/** Applies a changed preference to the document at once, persists it and re-renders the server parts. */
export function usePreferences(initial: Preferences) {
  const router = useRouter();
  const [preferences, setPreferences] = useState(initial);
  function change(key: PreferenceKey, value: string) {
    const next = readPreferences((name) => (name === key ? value : preferences[name]));
    setPreferences(next);
    const root = document.documentElement;
    root.lang = next.locale;
    root.dir = direction(next.locale);
    root.dataset.brand = next.brand;
    root.dataset.mode = next.mode;
    persistPreference(key, next[key]);
    if (key === 'locale') router.refresh();
  }
  return { preferences, change };
}
