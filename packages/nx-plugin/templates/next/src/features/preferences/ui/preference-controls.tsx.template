'use client';
import { Select } from '@mpfrontend/ui';
import { localeRegistry } from '../../../config/app';
import { brands } from '../../../theme/config';
import { usePreferences } from '../hooks/use-preferences';
import { messages } from '../model/messages';
import { modes, type Preferences } from '../model/preferences';

/** The language, brand and appearance controls. The view renders choices and emits changes. */
export function PreferenceControls({ initial }: { initial: Preferences }) {
  const { preferences, change } = usePreferences(initial);
  const t = messages.translator(preferences.locale);
  return (
    <div className="flex flex-wrap items-end gap-4 [&>.mp-field]:w-[180px]">
      <Select
        label={t('language')}
        value={preferences.locale}
        onChange={(event) => change('locale', event.target.value)}
      >
        {localeRegistry.locales.map((code) => (
          <option key={code} value={code} lang={code}>
            {new Intl.DisplayNames([code], { type: 'language' }).of(code)}
          </option>
        ))}
      </Select>
      <Select
        label={t('brand')}
        value={preferences.brand}
        onChange={(event) => change('brand', event.target.value)}
      >
        {brands.map((value) => (
          <option key={value} value={value}>
            {value}
          </option>
        ))}
      </Select>
      <Select
        label={t('mode')}
        value={preferences.mode}
        onChange={(event) => change('mode', event.target.value)}
      >
        {modes.map((value) => (
          <option key={value} value={value}>
            {t(value)}
          </option>
        ))}
      </Select>
    </div>
  );
}
