import { validMode, type Mode } from '@mpfrontend/tokens';
import { brandCookie, localeRegistry, preferenceCookie } from '../../../config/app';
import { validBrand, type Brand } from '../../../theme/config';

export type AppLocale = (typeof localeRegistry.locales)[number];
/** The presentation preferences of a visitor. They change presentation only, never authority. */
export type Preferences = Readonly<{ locale: AppLocale; brand: Brand; mode: Mode }>;
export type PreferenceKey = keyof Preferences;
export const modes = ['light', 'dark', 'system'] as const;

/**
 * Reads the shared preference cookie (language and theme) and the app's brand cookie by name. Every value is
 * validated; an unknown or missing value is the default, and an invalid cookie is ignored.
 */
export function readPreferences(cookie: (name: string) => string | undefined): Preferences {
  const shared = preferenceCookie.parse(cookie(preferenceCookie.name));
  return {
    locale: localeRegistry.locale(shared.lang),
    brand: validBrand(cookie(brandCookie)),
    mode: validMode(shared.theme),
  };
}
