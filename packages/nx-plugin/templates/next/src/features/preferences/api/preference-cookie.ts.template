import { brandCookie, preferenceCookie, preferenceCookieDomain } from '../../../config/app';
import type { Preferences } from '../model/preferences';

const attributes = () =>
  '; Path=/; SameSite=Lax; Max-Age=31536000' +
  (location.protocol === 'https:' ? '; Secure' : '') +
  (preferenceCookieDomain ? '; Domain=' + preferenceCookieDomain : '');

/** Persists validated preferences for the next first paint; the cookies hold no identity. */
export function persistPreferences(preferences: Preferences): void {
  const shared = preferenceCookie.value({ lang: preferences.locale, theme: preferences.mode });
  document.cookie = preferenceCookie.name + '=' + shared + attributes();
  document.cookie = brandCookie + '=' + encodeURIComponent(preferences.brand) + attributes();
}
