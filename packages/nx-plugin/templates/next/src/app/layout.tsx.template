import type { ReactNode } from 'react';
import { cookies } from 'next/headers';
import { direction, translator } from '@mpfrontend/i18n';
import { AppFrame, AppHeader, Navigation } from '@mpfrontend/app-layout';
import { PreferenceControls, readPreferences } from '../features/preferences';
import { appId, preferenceCookie } from '../config/app';
import './globals.css';

export const metadata = {
  title: appId + ' | MP Frontend',
  description: 'Independent MP Frontend consumer',
};

export default async function RootLayout({ children }: { children: ReactNode }) {
  const saved = await cookies();
  const preferences = readPreferences((key) => saved.get(preferenceCookie(key))?.value);
  const t = translator(preferences.locale);
  // The app passes the items it may show; the shell decides nothing about access.
  const items = [
    { href: '/catalog', label: t('catalog') },
    { href: '/components', label: 'Components' },
    { href: '/api/docs', label: t('docs') },
  ];
  return (
    <html
      lang={preferences.locale}
      dir={direction(preferences.locale)}
      data-brand={preferences.brand}
      data-mode={preferences.mode}
    >
      <body>
        <AppFrame
          skipLinkLabel={t('skipToContent')}
          header={
            <AppHeader
              brand={<a href="/catalog">{appId}</a>}
              navigation={<Navigation label={t('navigation')} items={items} />}
              actions={<PreferenceControls initial={preferences} />}
            />
          }
        >
          {children}
        </AppFrame>
      </body>
    </html>
  );
}
