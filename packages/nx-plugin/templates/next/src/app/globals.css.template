/* The global entry: imports and base element rules only. Layout comes from framework components and
   utility classes; token values come from the theme layer, which loads after the neutral fallback. */
@import 'tailwindcss';
@import '@mpfrontend/ui/tailwind.css';
@import '@mpfrontend/app-layout/tailwind.css';
@import '@mpfrontend/tokens/styles.css';
@import '@mpfrontend/ui/styles.css';
@import '@mpfrontend/app-layout/styles.css';
@import '../theme/theme.css';

* {
  box-sizing: border-box;
}
body {
  margin: 0;
  background: var(--mp-surface-canvas);
  color: var(--mp-foreground-primary);
  font-family: var(--mp-font-family);
}
a {
  color: inherit;
  text-underline-offset: 3px;
}
button,
input,
select {
  font: inherit;
}
:focus-visible {
  outline: 2px solid var(--mp-focus-ring);
  outline-offset: 2px;
}
