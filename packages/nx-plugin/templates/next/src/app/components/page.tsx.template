import { PageFrame } from '@mpfrontend/app-layout';
import { Button, Field, Select, Card } from '@mpfrontend/ui';
import { appMessages } from '../../i18n';
import { requestLocale } from '../../i18n/server';

export default async function Components() {
  const t = appMessages.translator(await requestLocale());
  return (
    <PageFrame title={t('componentsTitle')}>
      <Card>
        <div className="flex flex-wrap items-end gap-4">
          <Button>{t('continue')}</Button>
          <Button tone="secondary">{t('continue')}</Button>
          <Button disabled>{t('continue')}</Button>
        </div>
        <div className="mt-8 flex flex-wrap items-end gap-4 [&>.mp-field]:w-[180px]">
          <Field
            label={t('fieldLabel')}
            placeholder={t('fieldPlaceholder')}
            helper={t('fieldHelper')}
          />
          <Select label={t('account')} defaultValue="">
            <option value="" disabled>
              {t('selectOption')}
            </option>
            <option value="example">{t('exampleAccount')}</option>
          </Select>
        </div>
      </Card>
    </PageFrame>
  );
}
