{
  "name": "ui",
  "root": "packages/ui",
  "sourceRoot": "packages/ui/src",
  "projectType": "library",
  "tags": [
    "scope:platform",
    "runtime:client",
    "type:ui"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p packages/ui/tsconfig.json"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p packages/ui/tsconfig.json --noEmit"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint packages/ui/src packages/ui/tests"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --import tsx --test packages/ui/tests/*.test.ts",
        "env": { "TSX_TSCONFIG_PATH": "tsconfig.base.json" }
      }
    }
  }
}
