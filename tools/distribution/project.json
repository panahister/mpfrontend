{
  "name": "distribution",
  "projectType": "library",
  "tags": ["scope:tooling", "runtime:build", "type:verification"],
  "implicitDependencies": ["primitives", "ui", "tokens", "i18n", "access-core", "access-react", "data-react", "realtime-core", "security-bff", "presentation-server", "ftg-core", "ftg-cli", "nx-plugin", "ai-skills", "workspace-config", "app-layout"],
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {"command": "node --test tools/distribution/toolchain.test.mjs tools/distribution/release.test.mjs tools/distribution/api-baseline.test.mjs"}
    },
    "api-check": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["^build"],
      "options": {"command": "node tools/distribution/api-report.mjs check"}
    },
    "api-update": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["^build"],
      "options": {"command": "node tools/distribution/api-report.mjs update"}
    },
    "registry-install": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["pack-check"],
      "options": {"command": "node tools/distribution/registry-install.mjs"}
    },
    "negative-controls": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["^build"],
      "options": {"command":"node tools/distribution/negative-controls.mjs"}
    },
    "consumer-check": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["pack-check"],
      "options": { "command": "node --import tsx tools/distribution/consumer.mjs" }
    },
    "pack-check": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["^build"],
      "options": {"command": "node tools/distribution/pack.mjs"}
    }
  }
}
